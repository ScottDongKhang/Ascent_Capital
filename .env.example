# Ascent Capital — API Keys
# Copy this to .env and fill in your keys

# Price data (primary)
POLYGON_API_KEY=

# Price data (backup/validation)
TIINGO_API_KEY=

# Macro data
FRED_API_KEY=

# Fundamentals (future)
FMP_API_KEY=

# Broker (paper trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AI (optional, not used in core trading logic)
OPENAI_API_KEY=

# Alert push notifications (optional). Without this, alerts still land in
# logs/alerts.jsonl but no ntfy.sh push is sent — see ascent/monitoring/alert_system.py.
# Get a free topic name at https://ntfy.sh (pick any unguessable string, e.g. ascent-alerts-xyz123).
NTFY_TOPIC=
