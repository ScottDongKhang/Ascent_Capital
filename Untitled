python3 -c "
html = open('dashboard/ascent_terminal.html', encoding='utf-8').read()
import re, json

scripts = re.findall(r'<script[^>]*>(.*?)</script>', html, re.DOTALL)
for i, s in enumerate(scripts):
    s = s.strip()
    if s.startswith('const D=') or s.startswith('window.AD'):
        # extract the JSON part
        j = re.sub(r'^(const D=|window\.AD\s*=\s*)', '', s).rstrip(';')
        try:
            obj = json.loads(j)
            print(f'script {i} top-level keys:', list(obj.keys()))
        except Exception as e:
            print(f'script {i} parse error:', e)
