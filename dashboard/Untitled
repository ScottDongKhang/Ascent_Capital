        <div class="rb-track"><div class="rb-fill" style="background:#ef4444;width:${crisis}%"></div></div>
      </div>
    </div>
    <div style="margin-top:8px;padding-top:6px;border-top:1px solid var(--bd);font-size:8px;color:var(--dm)">
      Inputs: VIX level · VIX trend (63d MA) · HY spread · Yield curve
    </div>`;
}

