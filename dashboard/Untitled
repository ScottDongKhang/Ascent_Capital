    <div style="background:var(--bd);height:4px;margin-bottom:8px;position:relative">
      <div style="background:${info.color};height:4px;width:${(last.rs*100).toFixed(0)}%;transition:width .3s"></div>
    </div>
    <div style="font-size:8px;color:var(--mt);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px">Historical Regime Distribution</div>
    <div class="regime-bars">
