// ── REGIME DATA ──
// Simulated regime signal derived from equity return volatility + known market stress periods
// Replace with real output from ascent/risk/regime.py when Python exports it
(function(){
  const baseData = D;
  // Generate regime signal: uses rolling volatility of returns + known stress event overrides
  const regimeData = [];
  const lookback = 21;
  for(let i=0;i<baseData.length;i++){
    const slice = baseData.slice(Math.max(0,i-lookback),i+1).map(d=>d.r||0);
    const mean = slice.reduce((a,b)=>a+b,0)/slice.length;
    const variance = slice.reduce((a,b)=>a+(b-mean)**2,0)/slice.length;
    const vol = Math.sqrt(variance)*Math.sqrt(252);
    // Base signal inversely related to vol
    let sig = Math.max(0.1, Math.min(1.0, 1 - (vol - 10)/(80-10)));
    const d = baseData[i].d;
    // Override known stress periods
    if(d>='2020-02-20'&&d<='2020-04-01') sig=Math.min(sig,0.22);
    else if(d>='2020-04-01'&&d<='2020-06-30') sig=Math.min(sig,0.55);
    else if(d>='2022-01-01'&&d<='2022-07-15') sig=Math.min(sig,d>='2022-04-01'?0.28:0.52);
    else if(d>='2022-07-16'&&d<='2022-10-15') sig=Math.min(sig,0.42);
    else if(d>='2023-03-01'&&d<='2023-04-30') sig=Math.min(sig,0.60);
    regimeData.push({d:d, rs:parseFloat(sig.toFixed(3))});
  }
  window.REGIME = regimeData;
})();

function regimeLabel(v){
  if(v>=0.90) return {label:'CALM',cls:'rb-calm',color:'#10b981'};
  if(v>=0.60) return {label:'ELEVATED',cls:'rb-elevated',color:'#e8a308'};
  if(v>=0.35) return {label:'STRESS',cls:'rb-stress',color:'#f97316'};
  return {label:'CRISIS',cls:'rb-crisis',color:'#ef4444'};
}

function dRegime(el,data){
  el.innerHTML='';
  const cv=document.createElement('canvas');const dp=devicePixelRatio||1;
  const w=el.clientWidth,h=el.clientHeight;
  cv.width=w*dp;cv.height=h*dp;cv.style.width=w+'px';cv.style.height=h+'px';
  el.appendChild(cv);const x=cv.getContext('2d');x.scale(dp,dp);
  if(!data.length)return;
  const P={l:36,r:8,t:8,b:18},pw=w-P.l-P.r,ph=h-P.t-P.b;

  // Draw regime bands background
  const bands=[{min:0.9,max:1.0,col:'rgba(16,185,129,0.04)'},{min:0.6,max:0.9,col:'rgba(232,163,8,0.05)'},{min:0.35,max:0.6,col:'rgba(249,115,22,0.07)'},{min:0,max:0.35,col:'rgba(239,68,68,0.09)'}];
  bands.forEach(b=>{
    const y1=P.t+(1-b.max)*ph, y2=P.t+(1-b.min)*ph;
    x.fillStyle=b.col;x.fillRect(P.l,y1,pw,y2-y1);
  });

  // Grid lines at 0.35, 0.6, 0.9
  [0.35,0.6,0.9].forEach(v=>{
    const y=P.t+(1-v)*ph;
    x.strokeStyle='rgba(255,255,255,0.04)';x.lineWidth=.5;x.setLineDash([2,4]);
    x.beginPath();x.moveTo(P.l,y);x.lineTo(w-P.r,y);x.stroke();x.setLineDash([]);
  });

  // Y axis labels
  x.fillStyle='#5a6a7a';x.font='7px JetBrains Mono';
  [[1.0,'CALM'],[0.9,''],[0.6,'ELEV'],[0.35,'STRS'],[0.0,'CRIS']].forEach(([v,lbl])=>{
    if(!lbl)return;
    const y=P.t+(1-v)*ph;
    x.fillText(lbl,1,y+3);
  });

  // Plot regime signal with color-coded fill
  const pts=data.map((d,i)=>({x:P.l+(i/(data.length-1))*pw,y:P.t+(1-d.rs)*ph,v:d.rs,d:d.d}));
  // Color segments
  for(let i=1;i<pts.length;i++){
    const v=(pts[i-1].v+pts[i].v)/2;
    const info=regimeLabel(v);
    x.beginPath();x.moveTo(pts[i-1].x,pts[i-1].y);x.lineTo(pts[i].x,pts[i].y);
    x.lineTo(pts[i].x,P.t+ph);x.lineTo(pts[i-1].x,P.t+ph);x.closePath();
    const rgb=info.color.replace('#','').match(/.{2}/g).map(h=>parseInt(h,16));
    x.fillStyle=`rgba(${rgb[0]},${rgb[1]},${rgb[2]},0.15)`;x.fill();
  }
  // Line
  x.beginPath();pts.forEach((p,i)=>i===0?x.moveTo(p.x,p.y):x.lineTo(p.x,p.y));
  // Gradient stroke
  if(pts.length>1){
    const grad=x.createLinearGradient(P.l,0,w-P.r,0);
    pts.forEach((p,i)=>{const info=regimeLabel(p.v);grad.addColorStop(i/(pts.length-1),info.color);});
    x.strokeStyle=grad;
  } else {
    x.strokeStyle=regimeLabel(pts[0].v).color;
  }
  x.lineWidth=1.5;x.stroke();

  x.fillStyle='#5a6a7a';x.font='8px JetBrains Mono';
  x.fillText(data[0].d,P.l,h-3);x.textAlign='right';x.fillText(data[data.length-1].d,w-P.r,h-3);x.textAlign='left';

  // Tooltip
  const tp=document.createElement('div');tp.className='tt';el.appendChild(tp);
  cv.onmousemove=e=>{const r=cv.getBoundingClientRect(),mx2=e.clientX-r.left;let cl=pts[0],md=1e9;
  pts.forEach(p=>{const d=Math.abs(p.x-mx2);if(d<md){md=d;cl=p;}});
  if(cl&&md<40){const info=regimeLabel(cl.v);tp.style.display='block';tp.style.left=(cl.x+8)+'px';tp.style.top=(cl.y-24)+'px';
  tp.innerHTML=`<b>${cl.d}</b><br>Signal: ${cl.v.toFixed(2)} — <span style="color:${info.color}">${info.label}</span><br>Exposure: ${(cl.v*100).toFixed(0)}%`;}else tp.style.display='none';};
  cv.onmouseleave=()=>tp.style.display='none';
}

