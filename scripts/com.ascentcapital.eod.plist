<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ascentcapital.eod</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kdong/Downloads/ascent capital v2 up to phase 5.1/scripts/run_eod.sh</string>
    </array>

    <!-- 1:45pm PT = 4:45pm ET on weekdays -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>45</integer>
        <!-- Weekdays only: Monday=2 through Friday=6 -->
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/kdong/Downloads/ascent capital v2 up to phase 5.1/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kdong/Downloads/ascent capital v2 up to phase 5.1/logs/launchd_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
