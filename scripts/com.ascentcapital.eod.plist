<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ascentcapital.eod</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/scott/IdeaProjects/ascent-capital/scripts/run_eod.sh</string>
    </array>

    <!--
      09:00 local, Tuesday..Saturday.

      StartCalendarInterval is interpreted in MACHINE-local time, and this host
      is Asia/Ho_Chi_Minh (UTC+7) — NOT Pacific. The previous version of this
      file asserted "local machine time (PT here)" and used Hour=13 to mean
      1:45pm PT; on a UTC+7 host that fires at 22:45 PT the *previous* day,
      ~8h before the open and on the wrong US calendar day. Weekday=1 (local
      Monday) landed on Sunday night PT, when there is no session at all, and
      Friday's PT session never got a run.

      The mapping, verified against zoneinfo in both DST regimes:
        local Tue 09:00  ->  Mon 19:00 PDT / 18:00 PST  ->  Monday's session
        local Sat 09:00  ->  Fri 19:00 PDT / 18:00 PST  ->  Friday's session
      So Weekday 2..6 (Tue..Sat local) covers the Mon..Fri US sessions. Local
      Monday is deliberately absent: it would map to Sunday PT.

      09:00 rather than 08:00 because Alpaca settles its 1D bars ~17:00 PT.
      09:00 local leaves 2h of margin in summer and 1h in winter; 08:00 local
      lands exactly on 17:00 PST in winter, with no margin. Running after
      settlement is what makes Track B read real numbers instead of a fake 0.0.

      The run stamps its artifacts with the US market date (see
      ascent/utils/market_time.py), so a local-Tuesday run correctly writes
      Monday's session date.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>6</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/scott/IdeaProjects/ascent-capital/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/scott/IdeaProjects/ascent-capital/logs/launchd_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
